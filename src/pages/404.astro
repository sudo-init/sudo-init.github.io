---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="404" description="찾을 수 없는 페이지입니다.">
  <div class="notfound">
    <p class="meta">404</p>
    <h1 class="page-title">여기엔 아무것도 없습니다</h1>
    <p class="page-lead">주소가 바뀌었거나, 애초에 없던 글일 수 있습니다.</p>
    <a class="meta" href="/">← 목록으로</a>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--step-5);
  }

  .notfound a:hover {
    color: var(--accent);
  }
</style>
