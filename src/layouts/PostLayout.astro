---
import FormattedDate from '../components/FormattedDate.astro';
import TagPill from '../components/TagPill.astro';
import BaseLayout from './BaseLayout.astro';
import { readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
---

<BaseLayout
  pageTitle={title}
  description={description}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
>
  <article>
    <header>
      <p class="meta">
        <FormattedDate date={pubDate} />
        <span> · {readingTime(post.body)} min read</span>
        {draft && <span class="draft"> · draft</span>}
      </p>
      <h1>{title}</h1>
      {
        updatedDate && (
          <p class="meta updated">
            <FormattedDate date={updatedDate} /> 수정
          </p>
        )
      }
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <TagPill tag={tag} />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <nav class="back">
    <a class="meta" href="/">← 목록으로</a>
  </nav>
</BaseLayout>

<style>
  header {
    margin-bottom: var(--step-5);
    padding-bottom: var(--step-4);
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin: var(--step-1) 0 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .draft {
    color: var(--accent);
  }

  .updated {
    margin: var(--step-2) 0 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--step-2);
    margin: var(--step-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .back {
    margin-top: var(--step-6);
    padding-top: var(--step-3);
    border-top: 1px solid var(--border);
  }

  .back a:hover {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    h1 {
      font-size: 1.625rem;
    }
  }
</style>
